# Dev hodnoty. Skutocne tajomstva nepatria do gitu. Skopiruj na .env a zmen change-me-*.
# PHP-FPM ma clear_env=yes, CI4 cita vyhradne tento subor (bind mount).
# Iba dev: jeden subor pre compose aj CI4. Staging/produkcia ma tajomstva rozdelene na
# .env (compose, bez hesiel), app.env (php-fpm, iba app_rw), migrate.env (app_owner) a
# secrets/db_*_password (WR-06, docs/ops/server.md sekcie 6 a 15).
CI_ENVIRONMENT = development
app.baseURL = 'https://work-tracker.loc/'
APP_DOMAIN = work-tracker.loc
NGINX_HSTS_VALUE = max-age=300

# Heslia DB roli (docker compose)
DB_SUPERUSER_PASSWORD = change-me-superuser
DB_OWNER_PASSWORD = change-me-owner
DB_RW_PASSWORD = change-me-rw

# CI4 DB skupiny. Hesla sa musia zhodovat s DB_*_PASSWORD vyssie.
database.default.hostname = db
database.default.database = task_tracker
database.default.username = app_rw
# musi sa zhodovat s DB_RW_PASSWORD
database.default.password = change-me-rw
database.default.DBDriver = Postgre
database.default.port = 5432

database.owner.hostname = db
database.owner.database = task_tracker
database.owner.username = app_owner
# musi sa zhodovat s DB_OWNER_PASSWORD
database.owner.password = change-me-owner
database.owner.DBDriver = Postgre
database.owner.port = 5432

database.tests.hostname = db
database.tests.database = task_tracker_test
database.tests.username = app_rw
# musi sa zhodovat s DB_RW_PASSWORD
database.tests.password = change-me-rw
database.tests.DBDriver = Postgre
database.tests.port = 5432

database.tests_owner.hostname = db
database.tests_owner.database = task_tracker_test
database.tests_owner.username = app_owner
# musi sa zhodovat s DB_OWNER_PASSWORD
database.tests_owner.password = change-me-owner
database.tests_owner.DBDriver = Postgre
database.tests_owner.port = 5432

email.protocol = smtp
# smtp = odoslat cez SMTP, log = neodoslat, iba metadata do logu (staging pouziva log)
email.transport = smtp
email.SMTPHost = mailpit
email.SMTPPort = 1025
email.SMTPCrypto = ''
email.fromEmail = noreply@work-tracker.loc
email.fromName = 'Task Tracker (dev)'
email.allowedFromDomains = work-tracker.loc,vostack.dev
email.envelopeFrom = 

# Sodium, 32 bajtov: vygeneruj `make spark ARGS=key:generate`. Produkcia ma vlastny kluc,
# jeho strata znemozni desifrovat TOTP tajomstva.
encryption.key =

# Pepper pre HMAC zalozych kodov 2FA: vygeneruj `openssl rand -hex 32`. Kopiu uloz mimo servera;
# po strate sa zalozne kody nedaju overit.
auth.backupCodePepper =

# Iba dev: udaje seed admina pre `make reset-staging` (spark staging:seed). Na serveri su v secrets/seed_admin.env.
# Heslo musi splnat politiku hesiel. Seed admin je bez 2FA (SEED_ADMIN_TOTP_SECRET sa ignoruje).
# SEED_ADMIN_EMAIL = owner@example.test
# SEED_ADMIN_PASSWORD =
