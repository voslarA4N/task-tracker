server_tokens off;

# Limit pokusov na prihlasovacie URL (AUTH-04): kluc iba pre /login, /2fa, /password.
# Prazdny kluc = bez limitu. Kluc sa pocita z normalizovaneho $uri (dekodovane %XX,
# zlucene lomky, vyriesene ./..), nie zo suroveho $request_uri (WR-01: //login,
# /%6cogin, /index.php/login obchadzali limit). Pokryva aj formy, ktore CI4 smeruje
# na ten isty kontroler: /index.php/login a query-string /?/login, /index.php?/login.
# limit_req je v "location /" (pred vnutornym presmerovanim, ked $uri este nesie
# povodnu cestu) aj v "location = /index.php" (priamy /index.php?/...). nginx ho
# na jednu poziadavku uplatni iba raz.
map "$uri|$args" $auth_limit_key {
    "~^/(index\.php/)?(login|2fa|password)" $binary_remote_addr;
    "~^/(index\.php/?)?\|/"                 $binary_remote_addr;
    default "";
}
limit_req_zone $auth_limit_key zone=authz:1m rate=20r/m;
limit_req_status 429;

server {
    listen 80 default_server;
    server_name ${APP_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${APP_DOMAIN};
    # Predvolene zapnute; $uri pre $auth_limit_key na tom zavisi (WR-01).
    merge_slashes on;

    ssl_certificate ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:1m;

    # Skutocna IP klienta z Cloudflare (staging obraz); v dev je adresar prazdny.
    include /etc/nginx/realip.d/*.conf;

    root /var/www/html/public;
    index index.php;
    charset utf-8;
    client_max_body_size 5m;

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types text/css application/javascript image/svg+xml application/json text/plain;

    include /etc/nginx/conf.d/snippets/security-headers.conf;

    location ^~ /assets/ {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
        access_log off;
    }

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location ~ /\. {
        deny all;
    }

    location / {
        limit_req zone=authz burst=10 nodelay;
        try_files $uri /index.php$is_args$args;
    }

    location = /sw.js {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        fastcgi_hide_header Cache-Control;
        fastcgi_hide_header X-Powered-By;
        add_header Cache-Control "no-cache, no-store" always;
        fastcgi_pass php:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param HTTPS on;
    }

    location = /manifest.webmanifest {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location = /index.php {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        limit_req zone=authz burst=10 nodelay;
        fastcgi_hide_header Cache-Control;
        fastcgi_hide_header X-Powered-By;
        add_header Cache-Control "no-store" always;
        fastcgi_pass php:9000;
        fastcgi_read_timeout 30s;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param HTTPS on;
    }

    location ~ \.php$ {
        return 404;
    }
}
