add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'" always;
add_header Strict-Transport-Security "${NGINX_HSTS_VALUE}" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
# Staging nastavuje "noindex, nofollow" (NGINX_ROBOTS_TAG); prazdna hodnota = hlavicka sa neposle.
add_header X-Robots-Tag "${NGINX_ROBOTS_TAG}" always;
