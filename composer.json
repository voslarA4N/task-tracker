{
    "name": "voslara4n/task-tracker",
    "description": "Task Tracker (evidencia uloh a fakturacia)",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-bcmath": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pgsql": "*",
        "codeigniter4/framework": "^4.7.5",
        "codeigniter4/translations": "^4.7",
        "mpdf/mpdf": "^8.3.1"
    },
    "require-dev": {
        "codeigniter/phpstan-codeigniter": "^2.2",
        "codeigniter4/devkit": "^1.3",
        "fakerphp/faker": "^1.24",
        "mikey179/vfsstream": "^1.6.12",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:migrate": [
            "@php spark migrate -g tests_owner --all"
        ],
        "stan": [
            "phpstan analyse --no-progress --memory-limit=1G",
            "phpstan analyse -c phpstan.views.neon --no-progress --memory-limit=1G",
            "@php tests/_support/PhpStan/selftest.php"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --ansi",
        "cs-fix": "php-cs-fixer fix --ansi",
        "check": [
            "@stan",
            "@cs",
            "@test"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test": "Spusti vsetky testy (PHPUnit)",
        "test:unit": "Spusti unit testy",
        "test:migrate": "Migracie testovacej DB ako tests_owner",
        "stan": "PHPStan level 6 + self-test vlastneho pravidla",
        "cs": "Kontrola stylu kodu (php-cs-fixer, dry-run)",
        "cs-fix": "Oprava stylu kodu (php-cs-fixer)",
        "check": "stan + cs + test (jediny zdroj pravdy pre Makefile a CI)"
    }
}
