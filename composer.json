{
    "name": "voslara4n/task-tracker",
    "description": "Task Tracker (evidencia uloh a fakturacia)",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-bcmath": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pgsql": "*",
        "codeigniter4/framework": "^4.7.5",
        "codeigniter4/translations": "^4.7",
        "mpdf/mpdf": "^8.3.1"
    },
    "require-dev": {
        "codeigniter/phpstan-codeigniter": "^2.2",
        "codeigniter4/devkit": "^1.3",
        "fakerphp/faker": "^1.24",
        "mikey179/vfsstream": "^1.6.12",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:migrate": [
            "@php spark migrate -g tests_owner --all"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
