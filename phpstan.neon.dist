parameters:
    level: 6
    paths:
        - app
        - tests
    excludePaths:
        - tests/_support/PhpStan/Fixtures
        - app/Views
    tmpDir: build/phpstan
    codeigniter:
        schemaCacheDirectory: build/phpstan
    bootstrapFiles:
        - vendor/codeigniter4/framework/system/Test/bootstrap.php
    scanDirectories:
        - vendor/codeigniter4/framework/system/Helpers
    reportUnmatchedIgnoredErrors: true

services:
    -
        class: Tests\Support\PhpStan\ForbiddenCallsRule
        tags:
            - phpstan.rules.rule
